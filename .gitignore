# AI Hub 감성대화 말뭉치 원본 + NIA ALBERT 학습 산출물 (수백MB, 팀 로컬 전용)
/data/

# 루트에 만든 Python venv (server/venv는 server/.gitignore가 이미 커버).
/venv/
/.venv/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# DevTools local settings (auto-generated per developer)
devtools_options.yaml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

.env
# Widget Preview related
.widget_preview/

# Private device measurements/exports: never commit real user media.
private_measurements/
device_exports/
recordings/
captures/
baseline_voice_*.wav
diary_*_step1.wav
baseline_face_*.jpg
baseline_face_*.jpeg
baseline_face_*.png
CAP*.jpg
CAP*.jpeg
